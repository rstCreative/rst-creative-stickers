<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080B16" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ashley Stickers" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:textColor="#FF4FA3" android:textSize="28sp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Crea, edita, anima y comparte" android:textColor="#AEB5C8" android:textSize="14sp"/>
<ImageView android:id="@+id/studio_preview" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="18dp" android:background="#151A29" android:contentDescription="Vista previa del sticker" android:scaleType="fitCenter" android:src="@drawable/studio_empty"/>
<TextView android:id="@+id/studio_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Pulsa Crear Sticker para empezar." android:textColor="#C6CBDA" android:textSize="13sp"/>
<Button android:id="@+id/action_create" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:text="＋  Crear Sticker" android:textAllCaps="false" android:textSize="16sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
<Button android:id="@+id/action_remove_bg" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Eliminar fondo" android:textAllCaps="false"/>
<Space android:layout_width="8dp" android:layout_height="1dp"/>
<Button android:id="@+id/action_border" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Borde blanco" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<Button android:id="@+id/action_animate" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Animar" android:textAllCaps="false"/>
<Space android:layout_width="8dp" android:layout_height="1dp"/>
<Button android:id="@+id/action_ai" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Generar con IA" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<Button android:id="@+id/action_save" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Guardar" android:textAllCaps="false"/>
<Space android:layout_width="8dp" android:layout_height="1dp"/>
<Button android:id="@+id/action_share" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Compartir" android:textAllCaps="false"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
<Button android:id="@+id/action_packs" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Mis stickers" android:textAllCaps="false"/>
<Space android:layout_width="8dp" android:layout_height="1dp"/>
<Button android:id="@+id/action_clear" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Limpiar todo" android:textAllCaps="false"/>
</LinearLayout>
</LinearLayout>
</ScrollView>